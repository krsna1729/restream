{
  "version": 3,
  "commandSurface": "agent-canonical",
  "defaultCommand": "suite",
  "modeGroups": [
    {
      "kind": "suite",
      "group": "canonical-suites",
      "modes": {
        "suite": {
          "suiteRef": "suites.json#suites.default",
          "suiteDefault": false,
          "requires": {
            "portNamespace": false,
            "benchProfile": true
          }
        },
        "mixed.matrix": {
          "suiteRef": "suites.json#suites.mixed.matrix",
          "suiteDefault": true,
          "suiteOrder": 1000,
          "suiteTimeoutSecs": 5400,
          "requires": {
            "portNamespace": true,
            "benchProfile": true
          }
        },
        "mixed.signal": {
          "suiteRef": "suites.json#suites.mixed.signal",
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": true
          }
        },
        "mixed.fast-breadth": {
          "suiteRef": "suites.json#suites.mixed.fast-breadth",
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": true
          }
        },
        "ramp-family": {
          "suiteRef": "suites.json#suites.ramp-family",
          "suiteDefault": true,
          "suiteOrder": 700,
          "requires": {
            "portNamespace": true,
            "benchProfile": true
          },
          "foldedInto": "mixed"
        },
        "generic-sweeps": {
          "suiteRef": "suites.json#suites.generic-sweeps",
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": true
          },
          "foldedInto": "mixed"
        },
        "resource-sweep": {
          "suiteRef": "suites.json#suites.resource-sweep",
          "suiteDefault": true,
          "suiteOrder": 800,
          "suiteTimeoutSecs": 2400,
          "requires": {
            "portNamespace": true,
            "benchProfile": true
          },
          "foldedInto": "mixed"
        },
        "bitrate-sweep": {
          "suiteRef": "suites.json#suites.bitrate-sweep",
          "suiteDefault": true,
          "suiteOrder": 900,
          "suiteTimeoutSecs": 2400,
          "requires": {
            "portNamespace": true,
            "benchProfile": true
          },
          "foldedInto": "mixed+bitrate-axis"
        },
        "branch-matrix": {
          "suiteRef": "suites.json#suites.branch-matrix",
          "suiteDefault": true,
          "suiteOrder": 400,
          "requires": {
            "portNamespace": true,
            "benchProfile": true
          },
          "foldedInto": "mixed+branch-axis"
        },
        "backend-policy-matrix": {
          "suiteRef": "suites.json#suites.backend-policy-matrix",
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": true
          },
          "foldedInto": "mixed+backend-policy-axis"
        },
        "srt-crypto-matrix": {
          "suiteRef": "suites.json#suites.srt-crypto-matrix",
          "suiteDefault": true,
          "suiteOrder": 600,
          "requires": {
            "portNamespace": true,
            "benchProfile": true
          },
          "foldedInto": "mixed+srt-crypto-axis"
        }
      }
    },
    {
      "kind": "runner",
      "group": "special-workflows",
      "modes": {
        "api-smoke": {
          "suiteDefault": true,
          "suiteOrder": 100,
          "requires": {
            "portNamespace": true,
            "benchProfile": false
          },
          "purpose": "API/auth/DB persistence/health smoke"
        },
        "preflight": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": false
          },
          "purpose": "environment and binary availability checks"
        },
        "srt.policy": {
          "suiteDefault": true,
          "suiteOrder": 300,
          "requires": {
            "portNamespace": true,
            "benchProfile": false
          },
          "purpose": "SRT global/pipeline policy inheritance, override, and rejection behavior"
        },
        "msr": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": true
          },
          "purpose": "Mahashivratri hero scenario with multi-language SRT ingest and Zipfian RTMP/SRT output fan-out"
        },
        "msr.dashboard": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": true
          },
          "purpose": "Local overnight MSR soak with Playwright/CDP dashboard churn, diagnostics timing, and output lifecycle stress"
        },
        "timestamp.bframe": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": false
          },
          "purpose": "B-frame timestamp/DTS behavior",
          "migrationBlockedBy": "needs transcodeProfileAxis for full matrix coverage"
        },
        "file.live-edge": {
          "suiteDefault": true,
          "suiteOrder": 200,
          "requires": {
            "portNamespace": true,
            "benchProfile": false
          },
          "purpose": "file-ingest-as-live GOP/live-edge policy behavior"
        },
        "signal.control": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": false
          },
          "purpose": "AV signal-control knobs and signal-specific validation"
        },
        "fault.egress-retry": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": false
          },
          "purpose": "egress retry-budget/failure behavior"
        },
        "fault.output-stall": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": false
          },
          "purpose": "stalled sink/output fault behavior"
        },
        "fault.srt-output-stall": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": false
          },
          "purpose": "SRT destinations that stop taking data: bounded RSS against a frozen receiver, and the backpressured-but-connected stall path against a raw undrained SRT listener"
        },
        "srt.slow-peer": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": true
          },
          "purpose": "one genuinely slow APPLICATION SRT receiver (delivery paused, protocol alive) among healthy SRT outputs: healthy siblings must keep progressing and feed retention must stay bounded (WI2.5)"
        },
        "fault.resilience": {
          "suiteDefault": true,
          "suiteOrder": 500,
          "requires": {
            "portNamespace": true,
            "benchProfile": false
          },
          "purpose": "publisher disconnect, recovery, ingest lifecycle and cleanup coverage"
        },
        "recovery": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": true,
            "benchProfile": false
          },
          "purpose": "recovery-focused subset of fault behavior"
        },
        "srt-sink": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": false,
            "benchProfile": true
          },
          "purpose": "standalone SRT sink peer on this host for multi-host packet-rate rungs (RESOURCE_SWEEP_SRT_PEER_HOSTS on the measuring host); reports its own counters and UDP drop counters"
        },
        "udp-drain": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": false,
            "benchProfile": true
          },
          "purpose": "cheap wildcard UDP drain peer for substrate benchmarks: one receive socket per thread, counters and kernel drop counters on /state, so a sender result can be classified as receiver-limited or attributable"
        },
        "egress-duty": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": false,
            "benchProfile": false
          },
          "purpose": "WI3.6 Stage D: one live Restream SRT egress fanout against the independent pinned srt-bench receiver on the lane, over a rated window; reports the pinned SRT egress shard thread CPU and the whole Restream process CPU per first-transmission DATA datagram, plus the receiver's whole-run loss/reconciliation fence. Manages its own lane network namespace (`ip netns exec`) and takes explicit binary paths, so it is not gated on the bench profile"
        },
        "substrate-pps": {
          "suiteDefault": false,
          "requires": {
            "portNamespace": false,
            "benchProfile": true
          },
          "purpose": "substrate UDP submission benchmark (compio vs native io_uring): one pinned sender CPU, 1000 destinations over the veth lane, preconstructed payload, queue-depth window; reports pps, pps/core and payload Gbit/s with the drain peer's counters deciding attribution"
        }
      }
    }
  ],
  "dynamicModes": [
    {
      "namePrefix": "mixed.",
      "kind": "scenario",
      "scenarioSet": "scenarios/mixed.json#inputs",
      "scenarioIdField": "id",
      "workflowField": "workflow",
      "requiresFromScenario": "requires",
      "artifactRootFromScenario": "artifact.relDir"
    }
  ]
}
