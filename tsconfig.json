{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2020",
    "lib": ["ES2021", "DOM"],
    "moduleResolution": "bundler",
    "outDir": "public/js",
    "rootDir": "web/ts",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "removeComments": true
  },
  "include": ["web/ts/**/*.ts", "web/ts/**/*.d.ts"]
}
