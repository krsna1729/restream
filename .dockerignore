# Build artifacts — excluded to keep context small; Docker stages regenerate them
target/
.local/

# Runtime data — never bake into the image
.restream/
data.db
media/
logs/
__pycache__/
*.pyc

# FFmpeg is no longer embedded; keep stale host public/bin copies out of the
# build context (rust-embed would embed them).
public/bin/

# Source control and CI config
.git/
.github/
.claude/

# Docs, legacy, ops
docs/
old/
patches/
monitoring/
deploy/

# Node artefacts
node_modules/
public/
