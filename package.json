{
  "type": "module",
  "scripts": {
    "prepare:frontend-assets": "node ./scripts/dev/frontend/prepare-assets.mjs",
    "build:frontend": "npm run prepare:frontend-assets && npx tsc -p tsconfig.json && vite build && npx tailwindcss -i web/styles/input.css -o public/output.css",
    "build:css": "npx tailwindcss -i web/styles/input.css -o public/output.css",
    "check:api-contract": "cargo xtask api-contract",
    "format:check": "npx tsc -p tsconfig.json",
    "test:frontend": "./scripts/dev/frontend/node-tests.sh && npm run test:frontend:js-smoke",
    "test:frontend:coverage": "./scripts/dev/frontend/node-tests.sh --coverage && npm run test:frontend:js-smoke",
    "test:frontend:js-smoke": "npm run build:frontend && FRONTEND_MODULES_DIR=public/js node --experimental-default-type=module --test test/frontend/frontend-api-contract.test.mjs test/frontend/frontend-log-stream.test.mjs",
    "test:e2e": "./scripts/harness/frontend-e2e.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.7.47",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "hls.js": "^1.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
