{
  "type": "module",
  "scripts": {
    "prepare:frontend-assets": "node ./scripts/dev/frontend/prepare-assets.mjs",
    "build:frontend": "npm run prepare:frontend-assets && npx tsc -p tsconfig.json && vite build && npx tailwindcss -i web/styles/input.css -o public/output.css",
    "check:api-contract": "cargo xtask api-contract",
    "check:types": "npx tsc -p tsconfig.json",
    "test:frontend": "cargo xtask frontend node-tests && npm run test:frontend:js-smoke",
    "test:frontend:coverage": "cargo xtask frontend node-tests --coverage && npm run test:frontend:js-smoke",
    "test:frontend:js-smoke": "npm run build:frontend && FRONTEND_MODULES_DIR=public/js node --experimental-default-type=module --test test/frontend/frontend-api-contract.test.mjs test/frontend/frontend-log-stream.test.mjs",
    "test:e2e": "cargo xtask frontend e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.7.50",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@moq/watch": "^0.6.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "hls.js": "^1.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.1"
  }
}
