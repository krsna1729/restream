#!/usr/bin/env bash
set -euo pipefail

ROOT="${RESTREAM_REPO_ROOT:-$(git rev-parse --show-toplevel)}"
cd "$ROOT"

mapfile -t staged_files < <(git diff --cached --name-only --diff-filter=ACMR)

if ((${#staged_files[@]} == 0)); then
    exit 0
fi

rust_files=()
frontend_files=()
shell_files=()

for file in "${staged_files[@]}"; do
    if [[ "$file" == *.rs ]]; then
        rust_files+=("$file")
        continue
    fi

    if [[ "$file" == *.sh ]] || [[ "$file" == .githooks/* ]]; then
        shell_files+=("$file")
        continue
    fi

    if [[ "$file" =~ ^web/ts/.*\.ts$ ]] ||
        [[ "$file" =~ ^web/pages/.*\.html$ ]] ||
        [[ "$file" == "web/styles/input.css" ]]; then
        frontend_files+=("$file")
    fi
done

if ((${#rust_files[@]} > 0)); then
    echo "pre-commit: checking staged Rust formatting"
    if ! cargo fmt --all --check; then
        echo "pre-commit: Rust formatting check failed; run cargo fmt --all"
        exit 1
    fi
fi

if ((${#shell_files[@]} > 0)); then
    echo "pre-commit: checking staged shell syntax"
    for file in "${shell_files[@]}"; do
        bash -n "$file"
    done
fi

if ((${#frontend_files[@]} > 0)); then
    echo "pre-commit: type-checking staged frontend changes"
    if ! npx tsc -p tsconfig.json --noEmit; then
        echo "pre-commit: frontend type check failed; run npm run build:frontend"
        exit 1
    fi
fi
